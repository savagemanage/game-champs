; Engine configuration file.
; Godot 4.7.2 project.
; Hand-authored INI. config_version=5 is required for Godot 4.x.

config_version=5

[application]

config/name="wirework"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Telemetry (spec 2): the only telemetry piece that touches game scenes. It
; samples the player + titans each physics tick, feeds the pure RoundRecorder,
; owns the 24-bin PlayerModel + 3-round window ring buffer, and persists to
; user:// as JSON. Loaded as a global named "Telemetry".
Telemetry="*res://scripts/telemetry/telemetry.gd"
; TitanEvo (spec 3): game-side bridge between the PURE evo core (scripts/evo/)
; and gameplay. Loads the latest best genome from user://wirework_evo.json,
; exposes it for injection into the live titans, and runs the background
; evolution BETWEEN rounds (never during live play, steering 3.8). It is the
; only place scripts/evo/ touches the scene (it reads plain data from Telemetry).
TitanEvo="*res://scripts/titan/titan_evo_bridge.gd"

[input]

; --- Movement (WASD) ---
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
