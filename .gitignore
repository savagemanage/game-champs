# Godot 4.x .gitignore

# Import cache and generated metadata (regenerated on editor open).
.godot/

# Godot 4.x script UID sidecars (regenerated on import).
*.uid

# Compiled translations (generated from locale/*.csv on import).
*.translation

# GLB-embedded textures extracted on scene import.
assets/models/*_texture-*.png

# Downloaded Godot binary (spec 0 harness). Never commit the binary.
.godot-bin/

# Generated report/CSV artifacts (spec 0 harness).
reports/

# Imported asset metadata.
*.import

# Mono/.NET (unused here, but safe to ignore).
.mono/
data_*/

# Export artifacts.
export.cfg
export_presets.cfg
*.pck
*.zip
build/
exports/

# OS / editor cruft.
.DS_Store
Thumbs.db
*~

# Agent task state.
.agents/
